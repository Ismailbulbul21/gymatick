# GYMATICK — browser configuration
# Copy this file to .env.local and fill in the values from Supabase → Project Settings → API Keys.
#
# Every VITE_* variable is bundled into the JavaScript that ships to the browser.
# Only browser-safe values belong here. NEVER put the secret / service-role key
# (sb_secret_... or a JWT with role "service_role") in any VITE_* variable —
# the app refuses to start if you do.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
